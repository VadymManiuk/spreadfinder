# =============================================================================
# Spread Scanner Bot — Configuration
# Copy to .env and fill in your values.
# =============================================================================

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# --- Optional: dedicated bot for pump/dump alerts ---
# Both values are required. Pump alerts never fall back to the spread bot.
# PUMP_TELEGRAM_BOT_TOKEN=
# PUMP_TELEGRAM_CHAT_ID=

# --- Pump/Dump Detection ---
# PUMP_ENABLED=true
# PUMP_MIN_CHANGE_PCT=5.0
# PUMP_WINDOW_MINUTES=60
# PUMP_CHECK_INTERVAL_SECONDS=30
# PUMP_MIN_VOLUME_24H=100000
# PUMP_HISTORY_RETENTION_MINUTES=90
# PUMP_HISTORY_SAMPLE_INTERVAL_SECONDS=10
# PUMP_HISTORY_MAX_SAMPLES_PER_SERIES=600
# PUMP_HISTORY_WINDOW_BUFFER_MINUTES=30

# --- OKX Web3 API (required for OKX DEX Market API) ---
# OKX_API_KEY=
# OKX_API_SECRET=
# OKX_PASSPHRASE=
# OKX_PROJECT_ID=

# --- Optional OKX Exchange API (deposit/withdraw availability only) ---
# Use a separate read-only key from the regular OKX Exchange API.
# OKX_EXCHANGE_API_KEY=
# OKX_EXCHANGE_API_SECRET=
# OKX_EXCHANGE_PASSPHRASE=

# --- Filter Thresholds ---
# MIN_GROSS_SPREAD_BPS=10.0
# MAX_GROSS_SPREAD_BPS=500.0
# MIN_NET_SPREAD_BPS=5.0
# MIN_BID_SIZE=100.0
# MIN_ASK_SIZE=100.0
# MIN_VOLUME_24H=               # empty = disabled
# MAX_DATA_AGE_MS=2000
# COOLDOWN_SECONDS=300
# PERSISTENCE_MS=20000
# MIN_CONFIDENCE=0.3

# --- Exchange Fees (decimal fractions) ---
# BINANCE_MAKER=0.0002
# BINANCE_TAKER=0.0004
# HYPERLIQUID_MAKER=0.0002
# HYPERLIQUID_TAKER=0.0005
# GATE_MAKER=0.00015
# GATE_TAKER=0.0005
# SLIPPAGE_FACTOR=0.0001

# --- Adapter Settings ---
# STALE_THRESHOLD_SECONDS=10.0
# HEARTBEAT_INTERVAL_SECONDS=30.0
# META_POLL_INTERVAL_SECONDS=30.0

# --- DEX -> Futures Alerts ---
# DEX_ENABLED=true
# DEX_OKX_ENABLED=true
# DEX_BINANCE_ALPHA_ENABLED=true
# DEX_POLL_INTERVAL_SECONDS=30
# DEX_MIN_NET_SPREAD_PCT=10.0
# DEX_MIN_VOLUME_24H=2000000
# DEX_OKX_CHAIN_INDICES=8453

# --- Spot -> Futures Alerts ---
# Watches spot markets against enabled futures exchanges.
# Alerts only buy-spot -> sell/short-futures routes.
# SPOT_ENABLED=true
# SPOT_ENABLED_EXCHANGES=["binance_spot","gate_spot","bybit_spot","okx_spot","bitget_spot","mexc_spot"]
# SPOT_POLL_INTERVAL_SECONDS=30
# SPOT_MIN_NET_SPREAD_BPS=100.0
# SPOT_MIN_VOLUME_24H=          # empty = disabled

# --- Market Cap Filter ---
# MAX_MARKET_CAP=200000000       # $200M — tokens above this are skipped
# MCAP_REFRESH_INTERVAL=1800     # 30 minutes
# Optional: improves MCap coverage for long-tail pump/dump alerts.
# COINMARKETCAP_API_KEY=
# COINGECKO_API_KEY=

# --- General ---
# LOG_LEVEL=INFO
# ENABLED_EXCHANGES=binance,hyperliquid,gate
